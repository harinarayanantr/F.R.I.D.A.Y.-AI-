# --- Secrets ---
.env
*.key

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/
*.egg

# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- AI / ML model files (large binaries, auto-downloaded or manual) ---
*.tflite
*.task
backend/voice/model/

# --- Workspace (user data, known faces) ---
friday_workspace/known_faces/*
!friday_workspace/known_faces/.gitkeep
friday_workspace/~/

# --- Logs / temp ---
*.log
logs/
tmp/
*.tmp

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Arduino / PlatformIO builds ---
esp32_firmware/**/.pio/
esp32_firmware/**/build/
esp32_firmware/**/*.elf
esp32_firmware/**/*.bin
