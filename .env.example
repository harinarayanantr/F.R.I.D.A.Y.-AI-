# ============================================================
# F.R.I.D.A.Y. Environment Configuration
# Copy this file to ".env" and fill in your values:
#     cp .env.example .env
# ============================================================

# --- REQUIRED: Groq API key ---
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- LLM / STT models served by Groq ---
# llama-3.3-70b-* models are decommissioned. Active options (2026-08):
# openai/gpt-oss-120b | openai/gpt-oss-20b | qwen/qwen3.6-27b
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Wake word ---
WAKE_WORD=hey friday
WAKE_MODEL_PATH=backend/voice/model/vosk-model-small-en-us

# --- Text to speech ---
# Any edge-tts voice. en-IE-EmilyNeural / en-GB-SoniaNeural sound closest to FRIDAY's accent.
TTS_VOICE=en-IE-EmilyNeural
TTS_RATE=+8%

# --- HUD server ---
HUD_HOST=0.0.0.0
HUD_PORT=8000
OPEN_BROWSER_ON_START=true

# --- Computer vision ---
ENABLE_VISION=true
CAMERA_INDEX=0
ENABLE_FACE_RECOGNITION=false
GESTURE_DEBOUNCE_SECONDS=2.5

# --- Gesture -> action map (comma separated fingers:action) ---
GESTURE_1_ACTION=open_url:https://claude.ai
GESTURE_2_ACTION=open_url:http://localhost:8000/dashboard
GESTURE_3_ACTION=open_url:https://youtube.com
GESTURE_4_ACTION=open_url:https://google.com
GESTURE_5_ACTION=open_url:https://instagram.com

# --- ESP32 ---
ESP32_ENABLED=false
ESP32_IP=192.168.1.50
ESP32_POLL_SECONDS=3

# --- Safety ---
# Directory FRIDAY is allowed to freely read/write/delete files in.
FRIDAY_WORKSPACE=./friday_workspace
# If true, shell commands run without asking for confirmation in terminal.
AUTO_CONFIRM_SHELL=false
# Seconds to wait for a command approval from the HUD before auto-rejecting.
APPROVAL_TIMEOUT_SECONDS=60
# TEMPORARY testing switch: auto-approve all command approvals instantly.
# Keep false in production - true disables the permission gate entirely.
COMMAND_APPROVAL_BYPASS=false
